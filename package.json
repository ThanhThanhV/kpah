{
  "name": "kpah-web-recreation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "extract:assets": "python tools/extract_kpah_jar.py KPAH_278.jar",
    "analyze:classes": "python tools/analyze_class_files.py tools/reports/class-files",
    "verify:assets": "python tools/verify_asset_manifest.py public/assets/kpah-original --jar KPAH_278.jar",
    "suggest:class-roles": "python tools/suggest_class_roles.py tools/reports/kpah-class-analysis.json",
    "test:protocol": "python tools/kpah_protocol_reference.py --self-test",
    "catalog:protocol": "python tools/extract_protocol_catalog.py tools/reports/cfr-source",
    "generate:protocol": "python tools/generate_protocol.py",
    "check:protocol-generated": "python tools/generate_protocol.py --check",
    "test:protocol-codegen": "node tools/test_protocol_codegen.mjs",
    "test:replay-harness": "python tools/kpah_replay_harness.py --self-test",
    "generate:transport": "python tools/generate_transport_codec.py",
    "check:transport-generated": "python tools/generate_transport_codec.py --check",
    "test:transport-codegen": "node tools/test_transport_codegen.mjs",
    "generate:prefix-protocol": "python tools/generate_prefix_protocol.py",
    "check:prefix-protocol": "python tools/generate_prefix_protocol.py --check",
    "test:prefix-protocol": "node tools/test_prefix_protocol.mjs",
    "generate:initialization-protocol": "python tools/generate_initialization_codec.py",
    "check:initialization-protocol": "python tools/generate_initialization_codec.py --check",
    "test:initialization-protocol": "node tools/test_initialization_codec.mjs",
    "test:initialization-state": "node tools/test_initialization_state.mjs",
    "test:opcode1-state": "node tools/test_opcode1_state.mjs",
    "test:opcode3-extension-state": "node tools/test_opcode3_extension_state.mjs",
    "test:opcode15-state": "node tools/test_opcode15_state.mjs",
    "test:initialization-event": "node tools/test_initialization_event.mjs",
    "generate:opcode15": "python tools/generate_opcode15_codec.py",
    "check:opcode15": "python tools/generate_opcode15_codec.py --check",
    "test:opcode15": "node tools/test_opcode15_codec.mjs",
    "generate:opcode1": "python tools/generate_opcode1_codec.py",
    "check:opcode1": "python tools/generate_opcode1_codec.py --check",
    "test:opcode1": "node tools/test_opcode1_codec.mjs",
    "generate:opcode3-extension": "python tools/generate_opcode3_extension.py",
    "check:opcode3-extension": "python tools/generate_opcode3_extension.py --check",
    "test:opcode3-extension": "node tools/test_opcode3_extension.mjs",
    "generate:opcode5": "python tools/generate_opcode5_codec.py",
    "check:opcode5": "python tools/generate_opcode5_codec.py --check",
    "test:opcode5": "node tools/test_opcode5_codec.mjs",
    "generate:world-state": "python tools/generate_world_state_codec.py",
    "check:world-state": "python tools/generate_world_state_codec.py --check",
    "test:world-state": "node tools/test_world_state_codec.mjs",
    "generate:command-variants": "python tools/generate_command_variants.py",
    "check:command-variants": "python tools/generate_command_variants.py --check",
    "test:command-variants": "node tools/test_command_variants.mjs",
    "test:inbound-initialization": "node tools/test_inbound_initialization_adapter.mjs",
    "test:server-frame-stream": "node tools/test_server_frame_stream.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^6.4.1"
  }
}
